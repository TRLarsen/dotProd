# Machine-local chezmoi config, generated once by `chezmoi init` into
# ~/.config/chezmoi/chezmoi.toml -- NOT committed to git, so this is where
# genuinely per-machine (not per-repo) data belongs. See [personal] entries
# in .chezmoidata.toml with a `requires` key, and the dispatcher logic in
# run_after_20_configure_personal.sh.tmpl, for how this data gates
# machine-class-specific settings.
#
# Both answers below follow the same "discover, then confirm" pattern: the
# template inspects the machine, offers what it found as the prompt's
# DEFAULT, and you confirm or override it. Nothing is ever decided silently.
# Each is answered once per machine (the *Once prompt functions reuse the
# stored answer). To change them later, from an already-cloned source dir:
#   chezmoi init --prompt                  re-ask both, defaulting to what's detected now
#   chezmoi init --prompt --promptDefaults accept what's detected now, without asking
# The prompt TEXTS must stay stable: `--promptBool`/`--promptChoice` answers
# (README's non-interactive bootstrap, tests/) are keyed by them.
#
# `laptop` is auto-detected from the presence of a battery
# (/sys/class/power_supply/BAT*), but you're asked to confirm/override in
# case that heuristic is wrong (e.g. a desktop with a UPS reporting as a
# battery).
{{- $batteryPresent := gt (len (glob "/sys/class/power_supply/BAT*")) 0 -}}
{{- $laptop := promptBoolOnce . "laptop" "Is this a laptop" $batteryPresent }}

# `profile` picks which install profile this machine uses -- see the
# [profiles] capability table in .chezmoidata.toml and the "entry-in-profile"
# partial in .chezmoitemplates for how it's applied. Orthogonal to `laptop`
# (a shared/borrowed laptop can still be "minimal"). promptChoiceOnce (not
# promptStringOnce) validates the answer against the choices list, so a typo
# can't silently produce an unrecognized profile.
#
# The suggested default comes from detecting the two [profiles]
# capabilities on this machine:
#   sudo -- `sudo` is on PATH AND you're root or in a sudo/wheel/admin group.
#           Group membership is used instead of running `sudo -n true`: that
#           would miss password-protected sudo, and on a shared machine where
#           you aren't a sudoer it gets logged/reported as an incident.
#   gui  -- sudo, plus a display server ($WAYLAND_DISPLAY/$DISPLAY) or an
#           installed desktop session (/usr/share/{wayland-,x}sessions/
#           *.desktop -- the files, not the dirs: Fedora's `filesystem`
#           package creates both dirs empty even on servers). The session
#           files catch a desktop you're SSH'd into. gui implies sudo
#           because the gui_apps tier installs with sudo.
# `output` aborts the template if its command fails, so `id` runs behind
# `|| true` -- on an odd system it just counts as "no admin group".
{{- $sudoPath := lookPath "sudo" -}}
{{- $groups := regexSplit "\\s+" (output "sh" "-c" "id -Gn 2>/dev/null || true" | trim) -1 -}}
{{- $isRoot := eq (toString .chezmoi.uid) "0" -}}
{{- $adminGroup := "" -}}
{{- range list "sudo" "wheel" "admin" -}}
{{-   if and (eq $adminGroup "") (has . $groups) }}{{ $adminGroup = . }}{{ end -}}
{{- end -}}
{{- $canSudo := false -}}
{{- $sudoWhy := "" -}}
{{- if eq $sudoPath "" }}{{ $sudoWhy = "`sudo` is not on PATH" -}}
{{- else if $isRoot }}{{ $canSudo = true }}{{ $sudoWhy = "you are root" -}}
{{- else if $adminGroup }}{{ $canSudo = true }}{{ $sudoWhy = printf "you are in the %q group" $adminGroup -}}
{{- else }}{{ $sudoWhy = "you are not root or in a sudo/wheel/admin group" }}{{ end -}}
{{- $sessions := concat (glob "/usr/share/wayland-sessions/*.desktop") (glob "/usr/share/xsessions/*.desktop") -}}
{{- $hasDesktop := true -}}
{{- $desktopWhy := "" -}}
{{- if env "WAYLAND_DISPLAY" }}{{ $desktopWhy = "$WAYLAND_DISPLAY is set" -}}
{{- else if env "DISPLAY" }}{{ $desktopWhy = "$DISPLAY is set" -}}
{{- else if $sessions }}{{ $desktopWhy = printf "a desktop session is installed (%s)" (first $sessions) -}}
{{- else }}{{ $hasDesktop = false }}{{ $desktopWhy = "no $WAYLAND_DISPLAY/$DISPLAY and no desktop session in /usr/share/{wayland-,x}sessions" }}{{ end -}}
{{- /* Detected capabilities -> profile. Mirrors [profiles] in .chezmoidata.toml,
       which can't be read here (.chezmoidata isn't loaded when this template
       runs at init), so tests/check_invariants.py checks that every key
       matches its profile's [profiles] entry and that every reachable
       capability combination has a key. */ -}}
{{- $profileFor := dict
      "sudo=true gui=true"   "standard"
      "sudo=true gui=false"  "headless"
      "sudo=false gui=false" "minimal" -}}
{{- $caps := printf "sudo=%t gui=%t" $canSudo (and $canSudo $hasDesktop) -}}
{{- if not (hasKey $profileFor $caps) }}
{{-   fail (printf ".chezmoi.toml.tmpl: no profile for detected capabilities %q -- add it to $profileFor" $caps) }}
{{- end -}}
{{- $suggested := index $profileFor $caps -}}
{{- /* Explain the default before asking -- but only to a person at a
       terminal, so a piped/scripted init's stdout stays clean. */ -}}
{{- if stdinIsATTY }}
{{-   $stored := "" }}
{{-   if hasKey . "profile" }}{{ $stored = .profile }}{{ end }}
{{-   writeToStdout (printf "Install profile detection: %s; %s -- suggesting %q.\n" $sudoWhy $desktopWhy $suggested) }}
{{-   if and $stored (ne $stored $suggested) }}
{{-     writeToStdout (printf "  (This machine's stored profile is %q. `chezmoi init --prompt` re-asks.)\n" $stored) }}
{{-   end }}
{{- end }}
{{- $profile := promptChoiceOnce . "profile" "Which install profile is this machine (standard/headless/minimal)" (list "standard" "headless" "minimal") $suggested }}
[data]
    laptop  = {{ $laptop }}
    profile = {{ $profile | quote }}
