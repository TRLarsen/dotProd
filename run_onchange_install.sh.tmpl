#!/bin/bash
set -e

# version: 2.1

echo "Starting environment bootstrap..."

# ==========================================
# 0. PRE-INSTALL HEALTH CHECK (Collision Detection)
# ==========================================
echo "Running pre-install dependency collision check..."

# List of tools that mise will manage
# Dynamically generated list of binaries from .chezmoidata.toml
MISE_TOOLS=(
{{- range $package, $binary := .tools }}
    "{{ $binary }}"
{{- end }}
)

COLLISIONS_FOUND=0

for tool in "${MISE_TOOLS[@]}"; do
    if command -v "$tool" &> /dev/null; then
        TOOL_PATH=$(command -v "$tool")
        
        # If the path does not belong to mise, we have a rogue legacy install
        if [[ "$TOOL_PATH" != *".local/share/mise"* ]] && [[ "$TOOL_PATH" != *".local/bin/mise"* ]]; then
            echo "  ⚠️  [WARNING] Legacy installation found: $tool"
            echo "      Path: $TOOL_PATH"
            COLLISIONS_FOUND=$((COLLISIONS_FOUND + 1))
        fi
    fi
done

if [ "$COLLISIONS_FOUND" -gt 0 ]; then
    echo "---------------------------------------------------------"
    echo "❌ FATAL: Found $COLLISIONS_FOUND overlapping installations."
    echo "These rogue packages will collide with mise's pathing."
    echo "Please manually uninstall them before continuing."
    echo "(e.g., 'cargo uninstall <tool>', 'sudo apt remove <tool>', 'sudo npm uninstall -g <tool>')"
    echo "---------------------------------------------------------"
    exit 1 # Halt the script so you don't corrupt the environment
else
    echo "✓ Health check passed. No dependency collisions detected."
    echo "---------------------------------------------------------"
fi

# 1. Core System Dependencies
echo "Installing base apt packages..."
sudo apt update
sudo apt install -y curl git zsh flatpak software-properties-common shfmt npm clangd lldb

# Fix Ubuntu's lldb-dap naming quirk for Helix debugging
if ! command -v lldb-dap &> /dev/null; then
    echo "Symlinking lldb-dap for Helix..."
    mkdir -p "$HOME/.local/bin"
    LLDB_BIN=$(find /usr/bin -name "lldb-dap*" -o -name "lldb-vscode*" | head -n 1)
    if [ -n "$LLDB_BIN" ]; then
        ln -sf "$LLDB_BIN" "$HOME/.local/bin/lldb-dap"
    fi
fi

# 2. Rust Compiler (Managed natively by rustup, strictly for compilation)
if ! command -v cargo &> /dev/null; then
    echo "Installing Rust toolchain..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi
source "$HOME/.cargo/env"
rustup component add rust-analyzer

# Generate static Zsh completions for zero-latency startup
mkdir -p "$HOME/.local/share/zsh/completions"
rustup completions zsh > "$HOME/.local/share/zsh/completions/_cargo"

# 3. Install & Execute Mise (The Dev Environment)
if ! command -v mise &> /dev/null; then
    echo "Installing mise..."
    curl https://mise.run | sh
fi

echo "Installing user-space tools via mise..."
# This single command reads ~/.config/mise/config.toml and installs everything concurrently
~/.local/bin/mise install -y

# 4. GUI Applications
is_snap_installed() {
    if command -v snap &> /dev/null; then
        snap list "$1" &> /dev/null
        return 0
    fi
    return 1
}

if [ -n "$WAYLAND_DISPLAY" ] || [ -n "$DISPLAY" ]; then
    echo "Display server detected. Processing GUI applications..."

    if ! command -v ghostty &> /dev/null; then
        sudo add-apt-repository -y ppa:mkasberg/ghostty-ubuntu
        sudo apt update
        sudo apt install -y ghostty
    fi

    sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

    if ! is_snap_installed "firefox"; then sudo flatpak install -y flathub org.mozilla.firefox; fi
    if ! is_snap_installed "brave"; then sudo flatpak install -y flathub com.brave.Browser; fi
    if ! is_snap_installed "bitwarden"; then sudo flatpak install -y flathub com.bitwarden.desktop; fi
else
    echo "No display server detected. Skipping GUI tools."
fi

echo "Bootstrap complete!"
