#!/bin/bash
set -e

# version: 2

echo "Starting environment bootstrap..."

# 1. Core System Dependencies
echo "Installing base apt packages..."
sudo apt update
sudo apt install -y curl git zsh flatpak software-properties-common shfmt npm clangd lldb

# Fix Ubuntu's lldb-dap naming quirk for Helix debugging
if ! command -v lldb-dap &> /dev/null; then
    echo "Symlinking lldb-dap for Helix..."
    mkdir -p "$HOME/.local/bin"
    LLDB_BIN=$(find /usr/bin -name "lldb-dap*" -o -name "lldb-vscode*" | head -n 1)
    if [ -n "$LLDB_BIN" ]; then
        ln -sf "$LLDB_BIN" "$HOME/.local/bin/lldb-dap"
    fi
fi

# 2. Rust Compiler (Managed natively by rustup, strictly for compilation)
if ! command -v cargo &> /dev/null; then
    echo "Installing Rust toolchain..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi
source "$HOME/.cargo/env"
rustup component add rust-analyzer

# 3. Oh-My-Zsh
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    echo "Installing oh-my-zsh..."
    RUNZSH=no sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    sudo chsh -s $(which zsh) $USER
fi

# 4. Install & Execute Mise (The Dev Environment)
if ! command -v mise &> /dev/null; then
    echo "Installing mise..."
    curl https://mise.run | sh
fi

echo "Installing user-space tools via mise..."
# This single command reads ~/.config/mise/config.toml and installs everything concurrently
~/.local/bin/mise install -y

# 5. GUI Applications
is_snap_installed() {
    if command -v snap &> /dev/null; then
        snap list "$1" &> /dev/null
        return 0
    fi
    return 1
}

if [ -n "$WAYLAND_DISPLAY" ] || [ -n "$DISPLAY" ]; then
    echo "Display server detected. Processing GUI applications..."

    if ! command -v ghostty &> /dev/null; then
        sudo add-apt-repository -y ppa:mkasberg/ghostty-ubuntu
        sudo apt update
        sudo apt install -y ghostty
    fi

    sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

    if ! is_snap_installed "firefox"; then sudo flatpak install -y flathub org.mozilla.firefox; fi
    if ! is_snap_installed "brave"; then sudo flatpak install -y flathub com.brave.Browser; fi
    if ! is_snap_installed "bitwarden"; then sudo flatpak install -y flathub com.bitwarden.desktop; fi
else
    echo "No display server detected. Skipping GUI tools."
fi

source ~/.zshrc
echo "Bootstrap complete!"
