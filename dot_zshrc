# ----------------------------------------
# .ZSHRC
# ----------------------------------------

# 1. Path & Completions (Must be defined first)
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$HOME/Applications:$PATH
fpath=("$HOME/.local/share/zsh/completions" $fpath)

# ==========================================
# ZSH FOUNDATION
# ==========================================

# 2. History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt append_history share_history hist_ignore_all_dups hist_reduce_blanks

# 3. Directory Navigation
setopt auto_cd

# 4. Tab Completion (fzf-tab UI loaded via Sheldon below; zstyles are read
# lazily on <Tab>, so they can be set here)
autoload -Uz compinit
compinit
# Case-insensitive. The POSIX-class form matters: the older 'm:{a-zA-Z}={A-Za-z}'
# spelling inserts a bogus uppercase prefix on an empty word (`cd <Tab>` -> `cd B`).
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}'
zstyle ':completion:*' menu no           # fzf-tab replaces zsh's own menu

# eza and completion colors both come from LS_COLORS. Fedora sets it
# system-wide, but zsh on Ubuntu/Debian doesn't, so generate it from
# dircolors' defaults when it's missing so every machine shares one palette.
[[ -z $LS_COLORS ]] && (( $+commands[dircolors] )) && eval "$(dircolors -b)"
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' list-dirs-first true  # Mirrors eza's --group-directories-first
zstyle ':completion:*:descriptions' format '[%d]'  # Enables fzf-tab group headers
zstyle ':completion:*:git-checkout:*' sort false   # Keep git's recency order

# Shared by the `eza` alias and fzf-tab's previews so they can't drift apart.
_eza_flags=(--group-directories-first --icons=always --color=always)

# fzf-tab previews: eza for directories, bat for files, nothing otherwise
# ($realpath is the candidate resolved against the completed directory).
zstyle ':fzf-tab:complete:*:*' fzf-preview \
    "if [[ -d \$realpath ]]; then eza -1 ${_eza_flags[*]} -- \"\$realpath\";
     elif [[ -f \$realpath ]]; then bat --color=always --style=numbers --line-range=:200 -- \"\$realpath\"; fi"
# No (empty) preview pane where candidates are never paths, so descriptions
# get the full width: command names, and `-<Tab>` option lists.
zstyle ':fzf-tab:complete:-command-:*' fzf-preview ''
zstyle ':fzf-tab:complete:*:options' fzf-preview ''
zstyle ':fzf-tab:*' switch-group '<' '>'

# 5. Keybindings & Autocorrect
bindkey -v                               # vim mode
export KEYTIMEOUT=1                      # Eliminate the delay when pressing ESC
setopt correct                           # Enable spelling correction

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='hx'
fi
export VISUAL="$EDITOR"

# Rust (rustup's env file; absent where rust isn't installed, e.g. "minimal")
[[ -f $HOME/.cargo/env ]] && . "$HOME/.cargo/env"

# Use BitWarden SSH Agent (skip when inside an SSH session so the
# forwarded agent socket from `ssh -A` is left intact instead)
if [[ -z $SSH_CONNECTION ]]; then
  # Flatpak
  _bw_ssh_agent_sock=/home/trlarsen/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock

  # # Snap
  # _bw_ssh_agent_sock=/home/tyler-larsen/snap/bitwarden/current/.bitwarden-ssh-agent.sock

  # # Dynamically find the newest active Bitwarden snap socket
  # _bw_ssh_agent_sock=$(ls -td $HOME/snap/bitwarden/[0-9]*/.bitwarden-ssh-agent.sock 2>/dev/null | head -n 1)

  # Only point at it if the socket is actually live; otherwise leave
  # SSH_AUTH_SOCK unset rather than pointing at a dead path.
  [[ -S $_bw_ssh_agent_sock ]] && export SSH_AUTH_SOCK=$_bw_ssh_agent_sock
  unset _bw_ssh_agent_sock
fi

# ----------------------------------------
# Tool Initializations (Mise, Zellij, etc.)
# ----------------------------------------

# Use mise installed tools
eval "$(~/.local/bin/mise activate zsh)"

# Use zellij for tab/window management
eval "$(zellij setup --generate-auto-start zsh)"

# Initialize Zoxide (replaces cd)
eval "$(zoxide init zsh)"

# Initialize FZF (enables ctrl+r history search and alt+c directory jump)
source <(fzf --zsh)

# Initialize Atuin (overwrite ctrl+r history search; also binds UP and Vi
# Normal Mode `k` to atuin-up-search -- do not rebind those keys below)
eval "$(atuin init zsh)"

# Enable native uv autocompletion (uv isn't installed on "minimal")
if (( $+commands[uv] )); then
  eval "$(uv generate-shell-completion zsh)"
fi

# Initialize starship
eval "$(starship init zsh)"

# Load Sheldon plugins
eval "$(sheldon source)"

# Load zsh-patina syntax highlighting (resolved via the PATH `mise activate`
# set up above, not `mise which` -- the latter errors whenever "latest" has
# moved past the installed version, i.e. until the next `czup`)
if (( $+commands[zsh-patina] )); then
  eval "$(zsh-patina activate)"
fi

# Bind Ctrl+Y to accept command suggestions
bindkey -M viins '^Y' autosuggest-accept

# ----------------------------------------
# Aliases & Functions
# ----------------------------------------

# Run `chezmoi apply` and update current session
czap() {
    echo "Applying config..."
    chezmoi apply "$@" && exec zsh
}

# Upgrade Binaries and update current session
czup() {
    echo "Upgrading Mise tools..."
    mise upgrade
    echo "Upgrading Rust toolchain..."
    rustup update
    rustup completions zsh > "$HOME/.local/share/zsh/completions/_cargo"
    echo "Updating Sheldon plugins..."
    sheldon lock --update
    echo "Upgrades complete. Reloading shell..."
    exec zsh
}

# `eza` (`ls` replacement) default
if command -v eza &> /dev/null; then
    # Base command default behavior
    alias eza="eza ${_eza_flags[*]}"
fi

# Enable editing command line in $EDITOR
# Press alt + v to open current command in $EDITOR.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd '\ev' edit-command-line
bindkey -M viins '\ev' edit-command-line

# Serve/open Rust docs using a Python HTTP Server to avoid sandboxing permissions issues.
alias open_rust_docs='python3 -m http.server --directory "$(dirname $(rustup doc --path))"'

# Yazi recommended function to change CWD to selected directory.
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

# Command that deletes git branches that have been merged/removed from the remote
# This alias is safe and will not delete branches with unmerged changes
alias gitclean="git fetch -p && git branch -vv | awk '/: gone]/{print \$1}' | xargs -r git branch -d"
