# ----------------------------------------
# .ZSHRC
# ----------------------------------------

# If you come from bash you might have to change your $PATH.
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$HOME/Applications:$PATH

# Add custom completions to the Zsh function path (MUST be before Oh-My-Zsh)
fpath=("$HOME/.local/share/zsh/completions" $fpath)

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the Oh-My-Zsh theme to load (Blank to use starship)
ZSH_THEME=""

# Enable command auto-correction.
ENABLE_CORRECTION="true"

# Oh-My-Zsh plugins to load 
plugins=(git sudo extract chezmoi colored-man-pages)

source $ZSH/oh-my-zsh.sh

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='hx'
fi
export VISUAL="$EDITOR"

# Rust
. "$HOME/.cargo/env"

# Use BitWarden SSH Agent
export SSH_AUTH_SOCK=/home/tyler-larsen/snap/bitwarden/current/.bitwarden-ssh-agent.sock

# ----------------------------------------
# Tool Initializations (Mise, Zellij, etc.)
# ----------------------------------------

# Use mise installed tools
eval "$(~/.local/bin/mise activate zsh)"

# Use zellij for tab/window management
eval "$(zellij setup --generate-auto-start zsh)"

# Initialize Zoxide (replaces cd)
eval "$(zoxide init zsh)"

# Initialize FZF (enables ctrl+r history search and alt+c directory jump)
source <(fzf --zsh)

# Enable native uv autocompletion
eval "$(uv generate-shell-completion zsh)"

# Initialize starship
eval "$(starship init zsh)"

# ----------------------------------------
# Aliases & Functions
# ----------------------------------------

# Run `chezmoi apply` and update current session
czap() {
    echo "Applying config..."
    chezmoi apply "$@" && exec zsh
}

# Upgrade Binaries and update current session
czup() {
    echo "Upgrading Mise tools..."
    mise upgrade
    echo "Upgrading Rust toolchain..."
    rustup update
    rustup completions zsh > "$HOME/.local/share/zsh/completions/_cargo"
    echo "Upgrades complete. Reloading shell..."
    exec zsh
}
