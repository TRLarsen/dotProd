#!/bin/bash
# dotprod-check: reports software already installed outside this repo that
# would collide with what .chezmoidata.toml installs on this machine
# (profile "{{ .profile }}"): [user_tools] binaries found on PATH from
# somewhere other than mise, and [gui_apps] entries already installed as a
# Snap, a native package/manual install, or another Flatpak ID. Installs
# nothing, and runs the very same checks as the install tiers
# (run_onchange_before_02/03 include the same .chezmoitemplates partials),
# which abort `chezmoi apply` on any collision.
#
# Rendered by chezmoi from private_dot_local/bin/executable_dotprod-check.tmpl,
# so it reflects .chezmoidata.toml as of the last apply. To check pending
# edits (or a fresh `chezmoi init` that hasn't applied yet) without running
# any installer, deploy just this file first:
#     chezmoi apply ~/.local/bin/dotprod-check && dotprod-check
#
# Usage: dotprod-check [--fix]
#   --fix  after the report, offer to run each suggested removal command,
#          one at a time, asking first (needs a terminal; never run by chezmoi)
# Exit status: 0 no collisions (shadowed duplicates are reported but don't
# fail), 1 collisions found (or still present after --fix), 2 usage error.
set -euo pipefail

{{- if not (hasKey .profiles .profile) }}
{{- fail (printf "profile %q has no entry in [profiles] in .chezmoidata.toml -- add one or fix the machine-local profile value" .profile) }}
{{- end }}

fix=0
case "${1:-}" in
"") ;;
--fix) fix=1 ;;
-h | --help)
    sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "${BASH_SOURCE[0]}"
    exit 0
    ;;
*)
    echo "usage: dotprod-check [--fix]" >&2
    exit 2
    ;;
esac
if [[ $# -gt 1 ]]; then
    echo "usage: dotprod-check [--fix]" >&2
    exit 2
fi
if ((fix)); then
    # chezmoi sets CHEZMOI=1 for the scripts it runs; the install tiers must
    # never remove anything, so --fix refuses to run under one.
    if [[ -n "${CHEZMOI:-}" ]]; then
        echo "dotprod-check: refusing --fix from inside a chezmoi run" >&2
        exit 2
    fi
    if [[ ! -t 0 || ! -t 1 ]]; then
        echo "dotprod-check: --fix asks before every command, so it needs an interactive terminal" >&2
        exit 2
    fi
fi

{{ includeTemplate "collision-check-lib" . }}
{{ includeTemplate "collision-check-user-tools" . }}
{{ includeTemplate "collision-check-gui-apps" . }}

run_checks() {
    dotprod_reset_findings
    echo "[user_tools] (${#MISE_TOOLS[@]} binaries managed by mise on profile \"{{ .profile }}\")"
    dotprod_check_user_tools
{{- if index .profiles .profile "gui" }}
    echo "[gui_apps]"
    dotprod_check_gui_apps
    if [[ ${#DOTPROD_GUI_SKIPPED[@]} -gt 0 ]]; then
        echo "  (not probed -- installed by a custom script that checks for itself: ${DOTPROD_GUI_SKIPPED[*]})"
    fi
{{- else }}
    echo "[gui_apps] skipped: profile \"{{ .profile }}\" has no gui capability"
{{- end }}
    echo
    if ((DOTPROD_COLLISIONS > 0)); then
        echo "❌ $DOTPROD_COLLISIONS collision(s), $DOTPROD_WARNINGS shadowed duplicate(s). 'chezmoi apply' would abort"
        echo "   until each collision is fixed ('fix:' lines above, or 'dotprod-check --fix')."
    elif ((DOTPROD_WARNINGS > 0)); then
        echo "✔ No collisions; $DOTPROD_WARNINGS shadowed duplicate(s) (harmless while mise comes first on PATH)."
    else
        echo "✔ No collisions."
    fi
}

offer_fixes() {
    local i answer
    if [[ ${#DOTPROD_FIX_CMDS[@]} -eq 0 ]]; then
        echo "Nothing --fix can run: the findings above (if any) have to be removed by hand."
        return 0
    fi
    echo
    echo "--fix: each command runs only if you answer y (package managers may ask again)."
    for i in "${!DOTPROD_FIX_CMDS[@]}"; do
        echo
        echo "${DOTPROD_FIX_DESCS[i]}"
        read -r -p "  Run: ${DOTPROD_FIX_CMDS[i]}  [y/N] " answer
        case "$answer" in
        y | Y | yes | YES)
            eval "${DOTPROD_FIX_CMDS[i]}" || echo "  (command failed; continuing)"
            ;;
        *) echo "  skipped" ;;
        esac
    done
    echo
    echo "Re-checking..."
    hash -r
    run_checks
}

run_checks
((fix)) && offer_fixes
((DOTPROD_COLLISIONS == 0))
