#!/bin/bash
set -euo pipefail

echo "Executing user-space environment validation..."

# 1. INITIALIZE LANGUAGE TOOLCHAINS
echo "Provisioning compiler toolchains..."

{{ range $toolchain, $version := .toolchains }}
SCRIPT_PATH="$HOME/.local/share/chezmoi/.scripts/toolchains/{{ $toolchain }}.sh"

if [[ -f "$SCRIPT_PATH" ]]; then
    echo "⚙️  Executing installer for {{ $toolchain }} (Version: {{ $version }})..."
    bash "$SCRIPT_PATH" "{{ $version }}"
else
    echo "❌ Error: Toolchain script missing at $SCRIPT_PATH"
    exit 1
fi
{{ end }}

# Source environments immediately so mise can see newly installed compilers
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# 2. COLLISION DETECTION HEALTH CHECK
MISE_TOOLS=(
{{- range $package, $binary := .user_tools }}
    "{{ $binary }}"
{{- end }}
)

COLLISIONS=0
for tool in "${MISE_TOOLS[@]}"; do
    if command -v "$tool" &> /dev/null; then
        TOOL_PATH=$(command -v "$tool")
        if [[ "$TOOL_PATH" != *".local/share/mise"* ]] && [[ "$TOOL_PATH" != *".local/bin/mise"* ]] && [[ "$TOOL_PATH" != *".cargo/bin"* ]]; then
            echo "  ⚠️  [COLLISION] External binary detected: $tool ($TOOL_PATH)"
            COLLISIONS=$((COLLISIONS + 1))
        fi
    fi
done

if [ "$COLLISIONS" -gt 0 ]; then
    echo "❌ FATAL: Environment initialization aborted due to path conflicts."
    exit 1
fi

# 3. MISE RUNTIME ENGINE
if ! command -v mise &> /dev/null; then
    echo "Bootstrapping mise execution engine..."
    curl https://mise.run | sh
fi

echo "Deploying user-space applications concurrently..."
"$HOME/.local/bin/mise" install -y

# 4. LLDB-DAP SYM-LINKING FIX FOR HELIX
if ! command -v lldb-dap &> /dev/null; then
    mkdir -p "$HOME/.local/bin"
    LLDB_TARGET=$(find /usr/bin -name "lldb-dap*" -o -name "lldb-vscode*" 2>/dev/null | head -n 1)
    if [ -n "$LLDB_TARGET" ]; then
        ln -sf "$LLDB_TARGET" "$HOME/.local/bin/lldb-dap"
    fi
fi
