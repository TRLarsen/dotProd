#!/bin/bash
set -euo pipefail

{{- if not (hasKey .profiles .profile) }}
{{- fail (printf "profile %q has no entry in [profiles] in .chezmoidata.toml -- add one or fix the machine-local profile value" .profile) }}
{{- end }}

{{ if not (index .profiles .profile "gui") }}
echo "⏭️  Skipping gui_apps tier entirely: profile \"{{ .profile }}\" has no gui capability."
exit 0
{{ end }}

# Safely exit if no display server is running (e.g., SSH session, CI container).
# A "standard"/gui-capable profile can still be applying over a session with
# no display active (e.g. via SSH), so this check is additive to, not a
# substitute for, the profile capability check above.
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
    echo "No display server detected. Skipping GUI application bootstrap."
    exit 0
fi

echo "Display server detected. Validating GUI elements..."

# DUPLICATE-INSTALL GUARD: before installing anything, look for each app
# already installed some other way (a Snap, a native package or manual
# install, an alternate Flatpak ID) -- installing on top would leave two
# copies, two launchers ("Double Icon Syndrome") and two sets of config.
# Shared with ~/.local/bin/dotprod-check, which runs the same checks on
# demand; see the "collision-check-gui-apps" partial for what each entry is
# probed for. Like the [user_tools] guard in run_onchange_before_02, any
# collision aborts the tier with the exact command to fix it.
{{ includeTemplate "collision-check-lib" . }}
{{ includeTemplate "collision-check-gui-apps" . }}
echo "Checking [gui_apps] for existing installs from other sources..."
dotprod_check_gui_apps
dotprod_abort_if_collisions "gui_apps install"

# Pre-pass: does any [gui_apps] entry available on this profile opt into
# native = true? Only then do we need to resolve PKG_MANAGER / run apt-get
# update below -- avoids a wasted apt-get update (and sudo prompt) on
# machines with no native gui_apps entries.
{{- $has_native := false }}
{{- range $app, $app_identifier := .gui_apps }}
{{- if and (kindIs "map" $app_identifier) (hasKey $app_identifier "native") $app_identifier.native }}
{{- if eq (includeTemplate "entry-in-profile" (dict "entry" $app_identifier "profile" $.profile)) "true" }}
{{- $has_native = true }}
{{- end }}
{{- end }}
{{- end }}
{{ if $has_native }}
# Determine the native package manager based on OS (mirrors
# run_onchange_before_01; only needed because at least one [gui_apps] entry
# sets native = true).
{{ if eq .chezmoi.osRelease.id "ubuntu" "debian" }}
    PKG_MANAGER="sudo apt-get install -y"
    echo "Updating system package lists..."
    sudo apt-get update -y
{{ else if eq .chezmoi.osRelease.id "fedora" }}
    PKG_MANAGER="sudo dnf install -y"
{{ else if eq .chezmoi.osRelease.id "arch" }}
    PKG_MANAGER="sudo pacman -S --noconfirm"
{{ else }}
    echo "❌ Unsupported operating system topology."
    exit 1
{{ end }}
{{ end }}

# Ensure Flathub is registered before processing apps
if command -v flatpak &> /dev/null; then
    sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
fi

# Each entry is validated and normalized by the "gui-app-spec" partial (the
# same one the duplicate-install check above reads), which also decides the
# install method at render time: a custom script in .scripts/gui/ always
# wins, else native = true, else Flatpak.
{{ range $app, $app_identifier := .gui_apps }}
{{- if ne (includeTemplate "entry-in-profile" (dict "entry" $app_identifier "profile" $.profile)) "true" }}
echo "⏭️  Skipping {{ $app }} (not in profile \"{{ $.profile }}\")."
{{- else }}
{{- $spec := includeTemplate "gui-app-spec" (dict "app" $app "entry" $app_identifier "sourceDir" $.chezmoi.sourceDir) | fromJson }}
{{- if eq $spec.method "script" }}
# 1. Custom script (always wins, whether native or Flatpak)
SCRIPT_PATH="{{ $.chezmoi.sourceDir }}/.scripts/gui/{{ $app }}.sh.tmpl"
echo "🖥️  Running custom GUI installer for {{ $app }}..."
# Render the template via chezmoi first, then pipe to bash with $1 set to
# the package name (native entries) or the Flatpak ID / raw TOML value.
# CHEZMOI_EXECUTABLE/CHEZMOI_SOURCE_DIR are exported by chezmoi to its scripts;
# reading them at runtime (not rendering the binary path in) keeps a chezmoi
# upgrade from changing this script's hash and re-running the whole tier.
"${CHEZMOI_EXECUTABLE:-chezmoi}" execute-template --source "${CHEZMOI_SOURCE_DIR:-{{ $.chezmoi.sourceDir }}}" < "$SCRIPT_PATH" | bash -s -- "{{ $spec.script_arg }}"
{{- else if eq $spec.method "native" }}
# 2. Native install via the OS package manager (native = true)
if {{ range $i, $bin := $spec.bins }}{{ if $i }} || {{ end }}command -v "{{ $bin }}" &> /dev/null{{ end }}; then
    echo "✔ {{ $app }} is already installed (native)."
else
    echo "📦 Installing {{ $app }} via native package manager..."
    $PKG_MANAGER "{{ $app }}"
fi
{{- else }}
# 3. Flatpak from Flathub
if command -v flatpak &> /dev/null; then
    echo "📦 Checking Flatpak installation for {{ $app }}..."
    if ! flatpak list --app --columns=application | grep -qxF "{{ $spec.flatpak }}"; then
        echo "Installing {{ $spec.flatpak }}..."
        sudo flatpak install -y flathub "{{ $spec.flatpak }}"
    else
        echo "✔ {{ $app }} is already installed."
    fi
else
    echo "⚠️  Cannot install {{ $app }}: Flatpak is missing and no custom script found."
fi
{{- end }}
{{- end }}
{{ end }}
