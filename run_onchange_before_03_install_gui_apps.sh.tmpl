#!/bin/bash
set -euo pipefail

# Safely exit if no display server is running (e.g., SSH session, CI container)
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
    echo "No display server detected. Skipping GUI application bootstrap."
    exit 0
fi

echo "Display server detected. Validating GUI elements..."

# Ensure Flathub is registered before processing apps
if command -v flatpak &> /dev/null; then
    sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
fi

{{ range $app, $app_identifier := .gui_apps }}
SCRIPT_PATH="{{ $.chezmoi.sourceDir }}/.scripts/gui/{{ $app }}.sh.tmpl"

# 1. Try a custom script first
if [[ -f "$SCRIPT_PATH" ]]; then
    echo "🖥️  Running custom GUI installer for {{ $app }}..."
    # Render the template via chezmoi first, then pipe to bash with $1 set to $app_identifier
    chezmoi execute-template < "$SCRIPT_PATH" | bash -s -- "{{ $app_identifier }}"

# 2. Fallback strictly to Flatpak using the TOML value as the ID
elif command -v flatpak &> /dev/null; then
    # SAFETY GUARD: Catch missing custom scripts for non-Flatpak identifiers
    if [[ "{{ $app_identifier }}" == ppa:* ]] || [[ "{{ $app_identifier }}" == */* ]]; then
        echo "❌ Error: Missing custom installer script for {{ $app }}."
        echo "Cannot pass repository string '{{ $app_identifier }}' to Flatpak. Aborting."
        exit 1
    fi

    echo "📦 Checking Flatpak installation for {{ $app }}..."

    # DUPLICATE-INSTALL GUARD: if a native package already ships a desktop
    # entry under this exact Flatpak app ID, installing the Flatpak on top
    # would silently create two colliding "{{ $app }}" launchers (Double Icon
    # Syndrome) instead of one obvious winner.
    NATIVE_DESKTOP_FILE="/usr/share/applications/{{ $app_identifier }}.desktop"
    if [[ -f "$NATIVE_DESKTOP_FILE" && ! -L "$NATIVE_DESKTOP_FILE" ]]; then
        echo "❌ Error: A native package already provides {{ $app }} ($NATIVE_DESKTOP_FILE exists)."
        echo "Installing the Flatpak ({{ $app_identifier }}) on top would duplicate it."
        echo "Either uninstall the native package, or remove '{{ $app }}' from [gui_apps] in .chezmoidata.toml."
        exit 1
    fi

    if ! flatpak list | grep -q "{{ $app_identifier }}"; then
        echo "Installing {{ $app_identifier }}..."
        sudo flatpak install -y flathub "{{ $app_identifier }}"
    else
        echo "✔ {{ $app }} is already installed."
    fi
else
    echo "⚠️  Cannot install {{ $app }}: Flatpak is missing and no custom script found."
fi
{{ end }}
