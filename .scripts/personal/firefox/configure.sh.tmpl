#!/bin/bash
set -euo pipefail

# Personal, opt-in Firefox configuration -- see [personal.firefox] in
# .chezmoidata.toml. Only invoked by run_after_20_configure_personal.sh.tmpl
# when [personal.firefox].active is true (checked centrally there, not
# here). Targets the NATIVE Firefox package (installed via [gui_apps]'s
# native = true path in run_onchange_before_03), not a Flatpak. Reruns on
# every `chezmoi apply` (via the generic personal dispatcher) to pick up
# newly created profiles and stay current with upstream Betterfox -- every
# step below is cheap/idempotent.

if ! command -v firefox &> /dev/null; then
    exit 0
fi

{{ $firefox := index .personal "firefox" }}
echo "🔧 Syncing Betterfox + personal Firefox preferences..."

BETTERFOX_URL="https://raw.githubusercontent.com/yokoffing/Betterfox/main/user.js"
OVERRIDES_SRC="{{ $.chezmoi.sourceDir }}/.scripts/personal/firefox/user-overrides.js"

TMP_USERJS="$(mktemp)"
trap 'rm -f "$TMP_USERJS"' EXIT

if ! curl -fsSL "$BETTERFOX_URL" -o "$TMP_USERJS.betterfox"; then
    echo "⚠️  Could not fetch Betterfox defaults (offline?); skipping Firefox preference sync." >&2
else
    {
        echo "// AUTO-GENERATED by dotProd -- do not edit directly."
        echo "// Upstream: $BETTERFOX_URL"
        echo "// Personal overrides: edit $OVERRIDES_SRC in the dotfiles repo instead."
        echo
        cat "$TMP_USERJS.betterfox"
        echo
        echo "// ---- personal overrides (dotProd) ----"
        cat "$OVERRIDES_SRC"
    } >"$TMP_USERJS"
    rm -f "$TMP_USERJS.betterfox"

    find_profile_dirs() {
        local ini="$1"
        local base_dir
        base_dir="$(dirname "$ini")"
        [[ -f "$ini" ]] || return 0
        awk '
            /^\[/ { insection = ($0 ~ /^\[Profile/) }
            insection && /^Path=/ { sub(/^Path=/, ""); print }
        ' "$ini" | while IFS= read -r path; do
            echo "$base_dir/$path"
        done
    }

    PROFILE_DIRS=()
    while IFS= read -r dir; do
        [[ -n "$dir" ]] && PROFILE_DIRS+=("$dir")
    done < <(
        # Legacy path (still used by some distro-patched Firefox builds)...
        find_profile_dirs "$HOME/.mozilla/firefox/profiles.ini"
        # ...and the modern XDG path upstream Firefox has moved to.
        find_profile_dirs "$HOME/.config/mozilla/firefox/profiles.ini"
    )

    if [[ ${#PROFILE_DIRS[@]} -eq 0 ]]; then
        echo "⚠️  No Firefox profiles found yet. Launch Firefox once, then re-run 'chezmoi apply' to inject preferences."
    else
        for dir in "${PROFILE_DIRS[@]}"; do
            if [[ -d "$dir" ]]; then
                cp "$TMP_USERJS" "$dir/user.js"
                echo "  ✔ Wrote user.js to $dir"
            fi
        done
    fi
fi

{{ if index $firefox "extensions" -}}
{{- $exts := index $firefox "extensions" }}
{{- if gt (len $exts) 0 }}
echo "🧩 Installing required Firefox extensions via enterprise policy..."

# Cross-distro system-wide policy path Firefox reads regardless of where the
# package itself is installed (in addition to <installdir>/distribution/).
POLICY_DIR="/etc/firefox/policies"

sudo mkdir -p "$POLICY_DIR"
sudo tee "$POLICY_DIR/policies.json" >/dev/null <<'POLICY_EOF'
{
  "policies": {
    "ExtensionSettings": {
{{- $entries := list }}
{{- range $id, $slug := $exts }}
{{- $entries = append $entries (printf "      %q: {\n        \"install_url\": %q,\n        \"installation_mode\": \"force_installed\"\n      }" $id (printf "https://addons.mozilla.org/firefox/downloads/latest/%s/latest.xpi" $slug)) }}
{{- end }}
{{ join ",\n" $entries }}
    }
  }
}
POLICY_EOF
echo "  ✔ Wrote required-extensions policy ($POLICY_DIR/policies.json, {{ len $exts }} extension(s)). Restart Firefox to apply."
{{ end -}}
{{ end -}}
