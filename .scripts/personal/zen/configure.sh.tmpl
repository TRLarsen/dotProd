#!/bin/bash
set -euo pipefail

# Personal, opt-in Zen Browser configuration -- see [personal.zen] in
# .chezmoidata.toml. Only invoked by run_after_20_configure_personal.sh.tmpl
# when [personal.zen].active is true and the current profile is allowed by
# [personal.zen].profiles (both checked centrally there, not here). Targets
# the Flatpak build of Zen (installed via [gui_apps]'s default flatpak path
# in run_onchange_before_03), so profile data lives under
# ~/.var/app/app.zen_browser.zen/zen/ rather than ~/.zen. Reruns on every
# `chezmoi apply` (via the generic personal dispatcher) to pick up newly
# created profiles -- every step below is cheap/idempotent.

ZEN_FLATPAK_ID="app.zen_browser.zen"

if ! flatpak info "$ZEN_FLATPAK_ID" &> /dev/null; then
    exit 0
fi

{{ $zen := index .personal "zen" }}
echo "🔧 Syncing personal Zen preferences..."

OVERRIDES_SRC="{{ $.chezmoi.sourceDir }}/.scripts/personal/zen/user.js"
PROFILE_ROOT="$HOME/.var/app/$ZEN_FLATPAK_ID/zen"
INI="$PROFILE_ROOT/profiles.ini"

if [[ ! -f "$INI" ]]; then
    echo "⚠️  No Zen profiles found yet. Launch Zen once, then re-run 'chezmoi apply' to inject preferences."
else
    PROFILE_DIRS=()
    while IFS= read -r path; do
        [[ -n "$path" ]] && PROFILE_DIRS+=("$PROFILE_ROOT/$path")
    done < <(
        awk '
            /^\[/ { insection = ($0 ~ /^\[Profile/) }
            insection && /^Path=/ { sub(/^Path=/, ""); print }
        ' "$INI"
    )

    if [[ ${#PROFILE_DIRS[@]} -eq 0 ]]; then
        echo "⚠️  No Zen profiles found yet. Launch Zen once, then re-run 'chezmoi apply' to inject preferences."
    else
        for dir in "${PROFILE_DIRS[@]}"; do
            if [[ -d "$dir" ]]; then
                {
                    echo "// AUTO-GENERATED by dotProd -- do not edit directly."
                    echo "// Edit $OVERRIDES_SRC in the dotfiles repo instead."
                    echo
                    cat "$OVERRIDES_SRC"
                } >"$dir/user.js"
                echo "  ✔ Wrote user.js to $dir"
            fi
        done
    fi
fi

{{ if index $zen "extensions" -}}
{{- $exts := index $zen "extensions" }}
{{- if gt (len $exts) 0 }}
echo "🧩 Installing required Zen extensions via enterprise policy..."
echo "   ⚠️  Force-install policies on Flatpak Zen builds rely on an unverified"
echo "      mechanism (Flatpak's systemconfig extension point, by analogy with"
echo "      Firefox's own Flatpak). If the extensions below don't appear after"
echo "      restarting Zen, install them manually from addons.mozilla.org:"
{{- range $id, $slug := $exts }}
echo "        - https://addons.mozilla.org/firefox/addon/{{ $slug }}/"
{{- end }}

ZEN_ARCH="$(flatpak --default-arch)"
ZEN_BRANCH="stable"
POLICY_DIR="$HOME/.local/share/flatpak/extension/$ZEN_FLATPAK_ID.systemconfig/$ZEN_ARCH/$ZEN_BRANCH/policies"

flatpak install --user -y flathub "$ZEN_FLATPAK_ID.systemconfig" &> /dev/null || true

mkdir -p "$POLICY_DIR"
cat >"$POLICY_DIR/policies.json" <<POLICY_EOF
{
  "policies": {
    "ExtensionSettings": {
{{- $entries := list }}
{{- range $id, $slug := $exts }}
{{- $entries = append $entries (printf "      %q: {\n        \"install_url\": %q,\n        \"installation_mode\": \"force_installed\"\n      }" $id (printf "https://addons.mozilla.org/firefox/downloads/latest/%s/latest.xpi" $slug)) }}
{{- end }}
{{ join ",\n" $entries }}
    }
  }
}
POLICY_EOF
echo "  ✔ Wrote best-effort force-install policy ($POLICY_DIR/policies.json, {{ len $exts }} extension(s)). Restart Zen to check."
{{ end -}}
{{ end -}}
